# Policy inference service configuration.
# Copy to .env for local runs (`cp .env.example .env`) or set as real env vars
# (Lambda sets these in template.yaml > Environment > Variables).
# Precedence: environment variables > .env file > built-in defaults.

# When set, the binary serves plain HTTP instead of running under the Lambda
# runtime. Used by `make run`/`make debug`, the perf container, and local
# development. Leave empty/unset in the Lambda image. The -http-addr flag
# overrides this value.
HTTP_ADDR=:8080

# Structured log level: debug, info, warn, or error. The -log-level flag
# overrides this value (see `make debug`).
LOG_LEVEL=info

# Maximum accepted request body size, in bytes. Requests above this get
# HTTP 413 request_too_large.
MAX_BODY_BYTES=1048576

# Maximum number of nodes the DOT policy graph may reference.
MAX_POLICY_NODES=1000

# Maximum number of edge declarations in the policy graph.
MAX_POLICY_EDGES=5000

# Maximum length, in bytes, of a single edge `cond` expression.
MAX_CONDITION_BYTES=4096

# Maximum nesting depth of a condition expression (guards against
# pathological parenthesised/boolean chains).
MAX_EXPRESSION_DEPTH=64
